<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="analitica_mastershop.MastershopDashboard">
        <div class="o_mastershop_dashboard p-4" style="height: 100%; max-height: 100%; overflow-y: auto !important; overflow-x: hidden; flex: 1 1 100%;">
            <!-- Barra Superior / Encabezado -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div>
                    <h2 class="mb-1 text-primary fw-bold d-flex align-items-center">
                        <i class="fa fa-tachometer me-2"/> Tablero de Control - MasterShop
                    </h2>
                    <p class="text-muted mb-0">Métricas analíticas ejecutivas de ventas, clientes comisionistas y rentabilidad</p>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <!-- Selector de Mes / Periodo Histórico -->
                    <div class="input-group input-group-sm shadow-sm" style="width: auto;">
                        <span class="input-group-text bg-white text-muted fw-bold border-end-0">
                            <i class="fa fa-calendar me-1 text-primary"/> Mes:
                        </span>
                        <select class="form-select form-select-sm fw-semibold text-primary border-start-0" t-on-change="onPeriodChange" style="min-width: 170px; cursor: pointer;">
                            <t t-foreach="state.data.available_months" t-as="m" t-key="m.key">
                                <option t-att-value="m.key" t-att-selected="m.selected">
                                    <t t-esc="m.nombre"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <button class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm" t-on-click="() => this.loadData()">
                        <i class="fa fa-refresh" t-att-class="{'fa-spin': state.loading}"/>
                        <span>Actualizar</span>
                    </button>
                    <button class="btn btn-outline-secondary btn-sm shadow-sm" t-on-click="openInvoicesMonth">
                        <i class="fa fa-file-text-o me-1"/> Facturas del Mes
                    </button>
                    <button class="btn btn-outline-secondary btn-sm shadow-sm" t-on-click="openClientesMastershop">
                        <i class="fa fa-users me-1"/> Clientes MasterShop
                    </button>
                    <button class="btn btn-outline-secondary btn-sm shadow-sm" t-on-click="openComisiones">
                        <i class="fa fa-handshake-o me-1"/> Comisiones
                    </button>
                </div>
            </div>

            <!-- Loader cuando está cargando -->
            <t t-if="state.loading">
                <div class="text-center py-5">
                    <i class="fa fa-circle-o-notch fa-spin fa-3x text-primary mb-3"/>
                    <h5 class="text-muted">Calculando indicadores ejecutivos de MasterShop...</h5>
                </div>
            </t>

            <t t-else="">
                <!-- Fila 1: Tarjetas Principales de KPI -->
                <div class="row g-3 mb-4">
                    <!-- Tarjeta 1: Facturación del Mes vs Mes Anterior -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card h-100 shadow-sm border-0 o_kpi_card o_kpi_blue cursor-pointer" t-on-click="openInvoicesMonth" title="Clic para ver facturas del mes">
                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div>
                                        <span class="o_kpi_title">Facturación <t t-esc="state.data.mes_actual.nombre"/></span>
                                        <div class="o_kpi_main_num"><t t-esc="state.data.mes_actual.subtotal_fmt"/></div>
                                    </div>
                                    <div class="o_kpi_icon_wrapper" style="background: #eff6ff; color: #2563eb;">
                                        <i class="fa fa-dollar"/>
                                    </div>
                                </div>
                                <div class="o_exec_subbadge d-flex align-items-center justify-content-between">
                                    <span class="text-muted"><i class="fa fa-calculator me-1 opacity-75"/>Base Imponible</span>
                                    <span>c/IVA: <strong class="text-dark"><t t-esc="state.data.mes_actual.total_fmt"/></strong></span>
                                </div>
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <span t-attf-class="o_trend_badge #{state.data.variacion.positiva ? 'o_trend_up' : 'o_trend_down'}">
                                        <i t-attf-class="fa #{state.data.variacion.positiva ? 'fa-arrow-up' : 'fa-arrow-down'} me-1"/>
                                        <t t-esc="state.data.variacion.pct"/>%
                                    </span>
                                    <span class="text-muted small" style="font-size: 0.76rem;">vs mes ant. (<t t-esc="state.data.mes_anterior.subtotal_fmt"/>)</span>
                                </div>
                                <div class="d-flex align-items-center justify-content-between pt-2 border-top text-muted small mt-auto" style="font-size: 0.77rem;">
                                    <span><i class="fa fa-file-text-o me-1 text-primary"/> Facturas:</span>
                                    <span class="fw-semibold text-dark"><t t-esc="state.data.mes_actual.facturas"/> emitidas</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tarjeta 2: Ventas por POS -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card h-100 shadow-sm border-0 o_kpi_card o_kpi_green cursor-pointer" t-on-click="openInvoicesMonth">
                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div>
                                        <span class="o_kpi_title">Venta Punto de Venta (POS)</span>
                                        <div class="o_kpi_main_num" style="color: #059669;"><t t-esc="state.data.mes_actual.pos_ventas_fmt"/></div>
                                    </div>
                                    <div class="o_kpi_icon_wrapper" style="background: #ecfdf5; color: #059669;">
                                        <i class="fa fa-shopping-cart"/>
                                    </div>
                                </div>
                                <div class="o_exec_subbadge o_subbadge_green d-flex align-items-center justify-content-between">
                                    <span><i class="fa fa-desktop me-1 text-success"/>Mostrador / Tienda</span>
                                    <span class="fw-bold text-success"><t t-esc="state.data.mes_actual.pct_pos"/>% del mes</span>
                                </div>
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between small text-muted mb-1" style="font-size: 0.72rem;">
                                        <span>Proporción de canal</span>
                                        <span class="fw-bold text-success"><t t-esc="state.data.mes_actual.pct_pos"/>%</span>
                                    </div>
                                    <div class="o_progress_distribution">
                                        <div style="background-color: #059669;" t-attf-style="width: #{state.data.mes_actual.pct_pos}%;"/>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center justify-content-between pt-2 border-top text-muted small mt-auto" style="font-size: 0.77rem;">
                                    <span><i class="fa fa-check-circle me-1 text-success"/> Canal:</span>
                                    <span class="badge bg-light text-success border">POS MasterShop</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tarjeta 3: Ventas por Contabilidad Directa -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card h-100 shadow-sm border-0 o_kpi_card o_kpi_amber cursor-pointer" t-on-click="openInvoicesMonth">
                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div>
                                        <span class="o_kpi_title">Ventas Contabilidad Directa</span>
                                        <div class="o_kpi_main_num" style="color: #d97706;"><t t-esc="state.data.mes_actual.conta_ventas_fmt"/></div>
                                    </div>
                                    <div class="o_kpi_icon_wrapper" style="background: #fffbeb; color: #d97706;">
                                        <i class="fa fa-book"/>
                                    </div>
                                </div>
                                <div class="o_exec_subbadge o_subbadge_amber d-flex align-items-center justify-content-between">
                                    <span><i class="fa fa-building-o me-1 text-warning"/>Crédito / Directas</span>
                                    <span class="fw-bold" style="color: #b45309;"><t t-esc="state.data.mes_actual.pct_conta"/>% del mes</span>
                                </div>
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between small text-muted mb-1" style="font-size: 0.72rem;">
                                        <span>Proporción de canal</span>
                                        <span class="fw-bold" style="color: #b45309;"><t t-esc="state.data.mes_actual.pct_conta"/>%</span>
                                    </div>
                                    <div class="o_progress_distribution">
                                        <div style="background-color: #d97706;" t-attf-style="width: #{state.data.mes_actual.pct_conta}%;"/>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center justify-content-between pt-2 border-top text-muted small mt-auto" style="font-size: 0.77rem;">
                                    <span><i class="fa fa-file-text me-1 text-warning"/> Canal:</span>
                                    <span class="badge bg-light text-warning border">Facturación Contabilidad</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tarjeta 4: Facturado Anual Acumulado -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card h-100 shadow-sm border-0 o_kpi_card o_kpi_purple cursor-pointer" t-on-click="openInvoicesYear" title="Clic para ver facturas del año">
                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div>
                                        <span class="o_kpi_title">Facturado Año <t t-esc="state.data.total_anual.anio"/></span>
                                        <div class="o_kpi_main_num" style="color: #7c3aed;"><t t-esc="state.data.total_anual.monto_fmt"/></div>
                                    </div>
                                    <div class="o_kpi_icon_wrapper" style="background: #f5f3ff; color: #7c3aed;">
                                        <i class="fa fa-calendar-check-o"/>
                                    </div>
                                </div>
                                <div class="o_exec_subbadge o_subbadge_purple d-flex align-items-center justify-content-between">
                                    <span class="text-muted"><i class="fa fa-calendar me-1 opacity-75"/>Base Anual</span>
                                    <span>c/IVA: <strong style="color: #7c3aed;"><t t-esc="state.data.total_anual.monto_fmt"/></strong></span>
                                </div>
                                <div class="mb-3 text-muted small" style="font-size: 0.77rem;">
                                    <span><i class="fa fa-id-card-o me-1 text-purple"/> Base Imponible:</span>
                                    <span class="fw-bold text-dark ms-1"><t t-esc="state.data.total_anual.subtotal_fmt"/></span>
                                </div>
                                <div class="d-flex align-items-center justify-content-between pt-2 border-top text-muted small mt-auto" style="font-size: 0.77rem;">
                                    <span><i class="fa fa-users me-1 text-purple"/> Cartera de Clientes:</span>
                                    <span class="fw-semibold text-dark"><t t-esc="state.data.clientes_salud.total"/> registrados</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Fila 2: Proporción de Canales (POS vs Contabilidad Directa) -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0 text-dark d-flex align-items-center">
                                <i class="fa fa-pie-chart text-primary me-2"/> Proporción de Ventas: POS vs Contabilidad Directa
                            </h6>
                            <span class="badge bg-light text-secondary border"><t t-esc="state.data.mes_actual.nombre"/></span>
                        </div>
                        <div class="d-flex align-items-center justify-content-around flex-wrap py-2 gap-4">
                            <!-- Gráfico Donut CSS puro -->
                            <div class="o_donut_circle shadow-sm"
                                 t-attf-style="background: conic-gradient(#059669 0% #{state.data.mes_actual.pct_pos}%, #d97706 #{state.data.mes_actual.pct_pos}% 100%);">
                                <div class="o_donut_inner">
                                    <span class="fw-bold text-dark fs-5"><t t-esc="state.data.mes_actual.pct_pos"/>%</span>
                                    <span class="text-muted" style="font-size: 0.7rem;">POS</span>
                                </div>
                            </div>
                            <!-- Leyenda explicativa amplia -->
                            <div class="d-flex align-items-center gap-5 flex-wrap">
                                <div class="d-flex align-items-center gap-3">
                                    <div style="width: 16px; height: 16px; background: #059669; border-radius: 4px;"/>
                                    <div>
                                        <div class="small fw-semibold text-dark">Punto de Venta (POS)</div>
                                        <div class="fw-bold text-success fs-5"><t t-esc="state.data.mes_actual.pos_ventas_fmt"/></div>
                                        <div class="text-muted small"><t t-esc="state.data.mes_actual.pct_pos"/>% de la facturación del período</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-3">
                                    <div style="width: 16px; height: 16px; background: #d97706; border-radius: 4px;"/>
                                    <div>
                                        <div class="small fw-semibold text-dark">Contabilidad Directa</div>
                                        <div class="fw-bold text-warning fs-5" style="color: #b45309;"><t t-esc="state.data.mes_actual.conta_ventas_fmt"/></div>
                                        <div class="text-muted small"><t t-esc="state.data.mes_actual.pct_conta"/>% de la facturación del período</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Fila 3: Top Clientes & Top Vendedores Comisionistas -->
                <div class="row g-3 mb-4">
                    <!-- Top 5 Clientes -->
                    <div class="col-12 col-lg-6">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0 text-dark d-flex align-items-center">
                                    <i class="fa fa-trophy text-warning me-2"/> Top 5 Clientes MasterShop con Mayor Gasto
                                </h6>
                                <span class="badge bg-light text-muted border">Histórico</span>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0" style="font-size: 0.83rem;">
                                        <thead class="table-light text-muted" style="font-size: 0.75rem;">
                                            <tr>
                                                <th class="ps-3">#</th>
                                                <th>Cliente</th>
                                                <th class="text-center">Facturas</th>
                                                <th class="text-end pe-3">Total Facturado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-if="state.data.top_clientes.length === 0">
                                                <tr>
                                                    <td colspan="4" class="text-center text-muted py-4">No se registran compras todavía</td>
                                                </tr>
                                            </t>
                                            <t t-foreach="state.data.top_clientes" t-as="c" t-key="c.id">
                                                <tr class="cursor-pointer" t-on-click="() => this.openPartner(c.id, c.name)">
                                                    <td class="ps-3 text-muted fw-bold"><t t-esc="c_index + 1"/></td>
                                                    <td>
                                                        <div class="fw-semibold text-dark"><t t-esc="c.name"/></div>
                                                        <div class="text-muted small" style="font-size: 0.72rem;">Última: <t t-esc="c.ultima_fecha"/></div>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-light text-dark border px-2"><t t-esc="c.facturas"/></span>
                                                    </td>
                                                    <td class="text-end pe-3 fw-bold text-success"><t t-esc="c.total_fmt"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Top Vendedores Comisionistas -->
                    <div class="col-12 col-lg-6">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0 text-dark d-flex align-items-center">
                                    <i class="fa fa-star text-warning me-2"/> Top Vendedores Comisionistas
                                </h6>
                                <button class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.75rem;" t-on-click="openComisiones">
                                    Ver Detalle
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0" style="font-size: 0.83rem;">
                                        <thead class="table-light text-muted" style="font-size: 0.75rem;">
                                            <tr>
                                                <th class="ps-3">#</th>
                                                <th>Vendedor Comisionista</th>
                                                <th class="text-center">Ventas</th>
                                                <th class="text-end pe-3">Neto a Liquidar</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-if="state.data.top_vendedores.length === 0">
                                                <tr>
                                                    <td colspan="4" class="text-center text-muted py-4">No hay comisiones asignadas aún</td>
                                                </tr>
                                            </t>
                                            <t t-foreach="state.data.top_vendedores" t-as="v" t-key="v.id">
                                                <tr>
                                                    <td class="ps-3 text-muted fw-bold"><t t-esc="v_index + 1"/></td>
                                                    <td class="fw-semibold text-dark">
                                                        <i class="fa fa-user-circle-o me-1 text-primary"/>
                                                        <t t-esc="v.name"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-light text-dark border"><t t-esc="v.facturas"/> facturas</span>
                                                    </td>
                                                    <td class="text-end pe-3 fw-bold text-success"><t t-esc="v.neto_fmt"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Fila 4: Top 10 Productos Más Vendidos de MasterShop -->
                <div class="card shadow-sm border-0 mb-4" style="border-top: 3.5px solid #2563eb !important;">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-0 text-primary d-flex align-items-center">
                                <i class="fa fa-wrench me-2"/> Top 10 Productos Más Vendidos - <t t-esc="state.data.selected_period"/>
                            </h6>
                            <small class="text-muted">Ranking de herramientas y productos según volumen de unidades vendidas y facturación en el período seleccionado</small>
                        </div>
                        <span class="badge bg-light text-primary border"><t t-esc="state.data.selected_period"/></span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" style="font-size: 0.83rem;">
                                <thead class="table-light text-muted" style="font-size: 0.75rem;">
                                    <tr>
                                        <th class="ps-3" style="width: 50px;">#</th>
                                        <th>Producto / Herramienta</th>
                                        <th class="text-center">Código</th>
                                        <th class="text-center">Cantidad Vendida</th>
                                        <th class="text-end">Subtotal (Sin IVA)</th>
                                        <th class="text-end pe-3">Total Facturado (c/IVA)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.data.top_productos.length === 0">
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">
                                                No se registran productos vendidos todavía.
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-foreach="state.data.top_productos" t-as="p" t-key="p_index">
                                        <tr>
                                            <td class="ps-3 text-muted fw-bold">
                                                <span t-attf-class="badge rounded-circle #{p_index &lt; 3 ? 'bg-primary text-white' : 'bg-light text-dark border'}" style="width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem;">
                                                    <t t-esc="p_index + 1"/>
                                                </span>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark"><t t-esc="p.nombre"/></div>
                                            </td>
                                            <td class="text-center">
                                                <span t-if="p.codigo" class="badge bg-light text-secondary border px-2 py-1"><t t-esc="p.codigo"/></span>
                                                <span t-else="" class="text-muted small">-</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-primary-subtle text-primary fw-bold px-2 py-1 border" style="font-size: 0.82rem;">
                                                    <i class="fa fa-cubes me-1"/> <t t-esc="p.cantidad"/> unids
                                                </span>
                                            </td>
                                            <td class="text-end fw-semibold text-dark"><t t-esc="p.subtotal_fmt"/></td>
                                            <td class="text-end pe-3 fw-bold text-success fs-6"><t t-esc="p.total_fmt"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Fila 5: Evolución Histórica de Ventas (Últimos 12 Meses) -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-0 text-dark d-flex align-items-center">
                                <i class="fa fa-line-chart text-primary me-2"/> Evolución Histórica de Ventas MasterShop (Últimos 12 Meses)
                            </h6>
                            <small class="text-muted">Haga clic en "Ver Mes" para cargar instantáneamente todos los KPIs y análisis de ese período</small>
                        </div>
                        <span class="badge bg-light text-primary border">Filtro estricto MasterShop</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" style="font-size: 0.83rem;">
                                <thead class="table-light text-muted" style="font-size: 0.75rem;">
                                    <tr>
                                        <th class="ps-3">Mes / Período</th>
                                        <th class="text-center">Facturas</th>
                                        <th class="text-end">Subtotal (Sin IVA)</th>
                                        <th class="text-end">Total c/IVA</th>
                                        <th class="text-end">Promedio x Factura</th>
                                        <th class="text-center pe-3">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.historico_mensual" t-as="h" t-key="h.periodo">
                                        <tr class="cursor-pointer" t-on-click="() => this.selectPeriod(h.year, h.month)">
                                            <td class="ps-3 fw-bold text-dark"><t t-esc="h.periodo"/></td>
                                            <td class="text-center">
                                                <span class="badge rounded-pill bg-light text-dark border px-2 py-1"><t t-esc="h.facturas"/> facturas</span>
                                            </td>
                                            <td class="text-end fw-semibold text-dark"><t t-esc="h.subtotal_fmt"/></td>
                                            <td class="text-end fw-bold text-success"><t t-esc="h.total_con_iva_fmt"/></td>
                                            <td class="text-end text-muted"><t t-esc="h.promedio_fmt"/></td>
                                            <td class="text-center pe-3">
                                                <button class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem;">
