<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Categoría de Seguridad -->
        <record id="module_category_analitica_mastershop" model="ir.module.category">
            <field name="name">Analítica MasterShop</field>
            <field name="description">Control de acceso y permisos para el módulo Analítica MasterShop</field>
            <field name="sequence">55</field>
        </record>

        <!-- Grupo: Usuario -->
        <record id="group_analitica_mastershop_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="category_id" ref="module_category_analitica_mastershop"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Grupo: Administrador -->
        <record id="group_analitica_mastershop_manager" model="res.groups">
            <field name="name">Administrador</field>
            <field name="category_id" ref="module_category_analitica_mastershop"/>
            <field name="implied_ids" eval="[(4, ref('group_analitica_mastershop_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Regla Multi-Compañía -->
        <record id="rule_analitica_mastershop_company" model="ir.rule">
            <field name="name">Analítica MasterShop: Regla Multi-Compañía</field>
            <field name="model_id" ref="model_analitica_mastershop"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_mastershop_comision_regla_company" model="ir.rule">
            <field name="name">Comisiones regla: compañías permitidas</field>
            <field name="model_id" ref="model_mastershop_comision_regla"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_mastershop_comision_reporte_company" model="ir.rule">
            <field name="name">Comisiones reporte: compañías permitidas</field>
            <field name="model_id" ref="model_mastershop_comision_reporte"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
